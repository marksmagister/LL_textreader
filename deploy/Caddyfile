# Install to /etc/caddy/Caddyfile, then `systemctl reload caddy`.
#
# Caddy gets and renews the certificate on its own. The app has no login of its
# own beyond one shared password, so this is the only other door.

read.example.com {
	# Take the best certificate on offer. Let's Encrypt counts per *registered
	# domain*, and every netcup customer on a default v….ultrasrv.de name shares
	# one quota of fifty a week, so a real certificate here is a lottery —
	# decisions/0020. Caddy tries the issuers in order and falls back, so the
	# site is up either way, and because it walks the chain again at every
	# renewal, the warning disappears by itself the first time a slot is free.
	# A domain of your own never reaches the second line.
	tls {
		issuer acme
		issuer internal {
			# Deliberately short. Caddy walks this chain again whenever the
			# certificate it is serving needs renewing, so a one-hour stand-in
			# means it asks Let's Encrypt roughly every forty minutes until one
			# of those asks lands. Only the *first* real certificate is hard to
			# get: renewals are ARI-coordinated and exempt from the limit that
			# is blocking us, so winning once wins for good.
			lifetime 1h
		}
	}

	reverse_proxy 127.0.0.1:8000

	encode zstd gzip

	# The built frontend is fingerprinted by Vite, so it can be cached hard.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	log {
		output file /var/log/caddy/ll-textreader.log
		# Reading history is not access-log material.
		format filter {
			request>uri query {
				delete q
				delete lemma
			}
		}
	}
}
