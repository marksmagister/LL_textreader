# Copy to .env and adjust. .env is gitignored.

LL_TEXTREADER_DB_PATH=./data/ll_textreader.db
LL_TEXTREADER_DATA_DIR=./data
LL_TEXTREADER_HOST=127.0.0.1
LL_TEXTREADER_PORT=8000

# Comma-separated language codes to load NLP pipelines for at startup.
# Loading a spaCy/Stanza model costs ~100-500MB RSS each, so keep this short.
LL_TEXTREADER_LANGUAGES=fr

# Dev only: allow the Vite dev server origin through CORS.
LL_TEXTREADER_CORS_ORIGINS=http://localhost:5173

# One shared password, over HTTP basic auth. Empty means no password, which is
# fine on localhost and never fine behind a tunnel — scripts/serve.sh --share
# refuses to start without one. There are no accounts: whoever gets in reads
# with your lexicon.
LL_TEXTREADER_PASSWORD=
LL_TEXTREADER_USERNAME=read
