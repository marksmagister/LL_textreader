# systemctl enable --now ll-textreader-backup.timer
[Unit]
Description=Daily lexicon backup

[Timer]
OnCalendar=daily
# The box will not be busy at 03:00, but it might have been off — Persistent
# runs a missed backup at the next boot rather than skipping the day.
Persistent=true
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
