# Copy to .env and adjust. .env is gitignored.

LL_TEXTREADER_DB_PATH=./data/ll_textreader.db
LL_TEXTREADER_DATA_DIR=./data
LL_TEXTREADER_HOST=127.0.0.1
LL_TEXTREADER_PORT=8000

# Comma-separated language codes to load NLP pipelines for at startup.
# Loading a spaCy/Stanza model costs ~100-500MB RSS each, so keep this short.
LL_TEXTREADER_LANGUAGES=fr

# --- signing in (docs/decisions/0021) ---
#
# Google is the only way in. From an OAuth client at console.cloud.google.com:
# create the project, add these two values, register the redirect URI below on
# the client *exactly*, and press "Publish app" so the project is In production.
#
# Publishing matters more than it sounds. In Testing mode Google caps you at 100
# hand-listed users AND expires everyone's consent after seven days, so readers
# would be signed out weekly. Our scopes (openid, email, profile) are
# non-sensitive, so production needs no verification review at all.
LL_TEXTREADER_GOOGLE_CLIENT_ID=
LL_TEXTREADER_GOOGLE_CLIENT_SECRET=
LL_TEXTREADER_GOOGLE_REDIRECT_URI=https://example.com/api/auth/google/callback

# "open" lets anyone with a Google account sign up, until there are max_users of
# them; "off" closes the door without locking out anyone already in.
LL_TEXTREADER_SIGNUP=open
LL_TEXTREADER_MAX_USERS=100

# Idle days before a session expires. Touched on every request, so reading
# regularly never signs you out.
LL_TEXTREADER_SESSION_DAYS=90

# Session cookies are Secure, so browsers ignore them over plain http. Right
# everywhere except local development, where scripts/serve.sh sets it false.
LL_TEXTREADER_COOKIE_SECURE=true
