# Copy to .env and adjust. .env is gitignored.

LL_TEXTREADER_DB_PATH=./data/ll_textreader.db
LL_TEXTREADER_DATA_DIR=./data
LL_TEXTREADER_HOST=127.0.0.1
LL_TEXTREADER_PORT=8000

# Comma-separated language codes the menu offers. A model is loaded on first use
# of its language, never at startup, so an unused entry is free — but each one
# you actually read in costs ~100-500MB resident. Every code here needs its model
# downloaded: ./scripts/setup-models.sh fr ru it
LL_TEXTREADER_LANGUAGES=fr,ru,it

# --- signing in (docs/decisions/0022) ---
#
# Google is the only way in. From an OAuth client at console.cloud.google.com:
# create the project, add these two values, and register the redirect URI below
# on the client *exactly* — Google string-matches it, so a missing slash is a
# redirect_uri_mismatch and nothing else.
#
# The project stays in Testing status deliberately: only addresses on its
# test-user list can sign in, which keeps the instance non-public and makes that
# list the invite system. Google expires a test user's grant after seven days,
# which sounds alarming and is not — this app holds no refresh token and never
# calls Google after the sign-in exchange, so a reader is carried by our own
# cookie for LL_TEXTREADER_SESSION_DAYS. The only effect is one extra consent
# click for somebody signing in again a week later. See docs/deploying.md.
LL_TEXTREADER_GOOGLE_CLIENT_ID=
LL_TEXTREADER_GOOGLE_CLIENT_SECRET=
LL_TEXTREADER_GOOGLE_REDIRECT_URI=https://example.com/api/auth/google/callback

# The second gate, not the first: the Google project is in Testing status, so only
# addresses on its test-user list reach the callback at all. "open" therefore means
# "no further restriction beyond Google's list"; "off" closes our door as well,
# without locking out anyone already in.
LL_TEXTREADER_SIGNUP=open
LL_TEXTREADER_MAX_USERS=100

# Idle days before a session expires. Touched on every request, so reading
# regularly never signs you out.
LL_TEXTREADER_SESSION_DAYS=90

# Session cookies are Secure, so browsers ignore them over plain http. Right
# everywhere except local development, where scripts/serve.sh sets it false.
LL_TEXTREADER_COOKIE_SECURE=true
